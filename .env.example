# ====================================================================
# זו דוגמה בלבד. כדי להריץ את השרת במחשב שלך:
#   1. העתיקי את הקובץ הזה לקובץ חדש בשם  .env
#   2. החליפי את הערכים בערכים האמיתיים שלך
# את הקובץ .env לעולם לא מעלים ל-GitHub (הוא כבר ברשימת .gitignore).
# ב-Render מגדירים את אותם משתנים במסך Environment, ולא בקובץ.
# ====================================================================

# --- חובה ---------------------------------------------------------
# כתובת החיבור למסד הנתונים PostgreSQL (Connection String)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# מחרוזת סודית ארוכה (לפחות 32 תווים) לחתימת ה-JWT. אסור שתהיה ידועה לאחרים.
JWT_SECRET="replace-this-with-a-long-random-secret-at-least-32-characters"

# --- אופציונלי (יש ערכי ברירת מחדל) ---------------------------------
PORT=3000
NODE_ENV=development

# כמה זמן ה-Token תקף (למשל 24h או 7d)
JWT_EXPIRES_IN=24h

# הכתובות של אתר ה-React שמותר להן לפנות לשרת, מופרדות בפסיק.
# בפרודקשן שימי כאן את הכתובת האמיתית של האתר שלך.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# כמה שניות (באלפיות שנייה) אחרי הכניסה לאתר קופצות ההתראות שלא נקראו
NOTIFICATION_BACKLOG_DELAY_MS=3000

# תזכורת לתור קופצת כך מספר דקות לפני התור
APPOINTMENT_REMINDER_MINUTES=30

# כל כמה זמן (באלפיות שנייה) השרת בודק אילו תזכורות צריכות לקפוץ
REMINDER_INTERVAL_MS=60000
REMINDER_JOB_ENABLED=true

# --- חשבונות הצוות ונתוני הדגמה -------------------------------------
# אם מגדירים סיסמה כאן, בהפעלה הראשונה השרת ייצור 3 אנשי צוות (אחות,
# עובדת סוציאלית, מטפלת התפתחותית) בסיסמה הזו, אם עדיין אין אנשי צוות.
# SEED_STAFF_PASSWORD=choose-a-strong-password

# להוספת אמהות, לוח, צ'אטים ומאמרים לדוגמה (לצורך הדגמה בלבד):
# SEED_DEMO_DATA=true
# SEED_DEMO_PASSWORD=choose-another-strong-password

# --- בדיקות אוטומטיות ----------------------------------------------
# מסד נתונים נפרד לבדיקות. השם שלו חייב להכיל את המילה test.
# הבדיקות מוחקות את כל הנתונים בו! לעולם לא להשתמש במסד האמיתי.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/preemie_test"
